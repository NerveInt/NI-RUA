# Local environments and Python/build caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
node_modules
node_modules/
# Generated by scripts/build_package.py from versioned sources.
ni_rua/web_assets/
ni_rua/reference_sources/

# Machine-local configuration and credentials: every configs/*.local.json (run configs, SO-101 deployment, the
# official-format key files claude*.local.json / opencode*.local.json) and the provider profiles directory
# (<id>.local.json with inline keys, retired *.removed-* copies, model-listing cache, presets).
/configs/*.local.json
/configs/profiles/
/configs/profiles/.cache/
# Private companion checkout with internal records, cloned separately.
/lab/
.env
.env.*
!.env.example
*.pem
*.key
.dev.vars
.dev.vars.*
.wrangler/
.DS_Store
.idea/

# Generated runtime data; keep small versioned fixtures in fixtures/
runs/
artifacts/
checkpoints/
weights/
*.log
/core
!/ni_rua/core/
core.*

# SQLite working sidecars are not versioned.
*.sqlite-wal
*.sqlite-shm

# Timestamped copies of the machine-local SO-101 deployment
/configs/*.local.json.bak*
# Claude Code agent worktrees (other branches checked out locally)
/.claude/worktrees/
# Local per-module test timing history for LPT scheduling
.ni-rua-test-timings.json
.ni-rua-test-timings.json.tmp
