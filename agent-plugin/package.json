  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".mcp.json",
    ".codex-mcp.json",
    "codex-models.direct.json",
    "hooks",
    "manifest.generated.json",
    "opencode",
    "skills",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
